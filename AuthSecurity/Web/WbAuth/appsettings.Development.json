{
  "DetailedErrors": true,
  "App": {
    "BaseUrl": "https://localhost:5001"
  },
  "ConnectionStrings": {
    "SqlitePath": "../../../SharedData/CentralAuth.db"
  },
  "Jwt": {
    "Key": "DEV_ONLY_KEY_DO_NOT_USE_IN_PRODUCTION_MIN_32_CHARS_REQUIRED",
    "Issuer": "SysteknaAuth",
    "Audience": "SysteknaUsers"
  },
  "Security": {
    "PasswordPolicy": {
      "MinLength": 6,
      "RequireUppercase": false,
      "RequireLowercase": false,
      "RequireDigit": false,
      "RequireSpecialChar": false
    },
    "RateLimit": {
      "MaxLoginAttempts": 100,
      "LockoutMinutes": 1
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

@{
    ViewData["Title"] = "Minha Conta";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Minha Conta | PixelDisplay240</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/account.css" />
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <a href="/" class="header-logo">PixelDisplay240</a>
        <nav class="header-nav">
            <a href="/"><i data-lucide="home"></i> Início</a>
            <a href="/Account/Profile" class="active"><i data-lucide="user"></i> Minha Conta</a>
            <a href="/Account/Logout"><i data-lucide="log-out"></i> Sair</a>
        </nav>
    </header>

    <div class="container">
        <h1 class="page-title">
            <i data-lucide="user-circle" style="width: 32px; height: 32px;"></i>
            Minha Conta
        </h1>
        <p class="page-subtitle">Gerencie suas informações pessoais, segurança e configurações</p>

        <div id="globalAlert" class="alert"></div>

        <div class="grid">
            <!-- Sidebar -->
            <aside class="sidebar glass-panel">
                <ul class="sidebar-menu">
                    <li><a href="#profile" class="active" data-section="profile"><i data-lucide="user"></i> Perfil</a></li>
                    <li><a href="#security" data-section="security"><i data-lucide="shield"></i> Segurança</a></li>
                    <li><a href="#api-keys" data-section="api-keys"><i data-lucide="key"></i> Chaves de API</a></li>
                    <li><a href="#preferences" data-section="preferences"><i data-lucide="settings"></i> Preferências</a></li>
                    <li><a href="#sessions" data-section="sessions"><i data-lucide="monitor"></i> Sessões</a></li>
                    <li><a href="#danger" data-section="danger"><i data-lucide="alert-triangle"></i> Zona de Perigo</a></li>
                </ul>
            </aside>

            <!-- Content -->
            <main>
                <!-- Profile Section -->
                <section id="profile" class="content-section active">
                    <div class="avatar-section">
                        <div class="avatar" id="userAvatar">?</div>
                        <div class="avatar-info">
                            <h3 id="userName">Carregando...</h3>
                            <p id="userEmail">...</p>
                            <span class="badge badge-user" id="userRole">User</span>
                        </div>
                    </div>

                    <div class="card glass-panel">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="edit-3"></i> Informações Pessoais</h3>
                        </div>
                        
                        <div class="form-group">
                            <label>Nome de Usuário</label>
                            <input type="text" id="profileUsername" disabled />
                            <small>O nome de usuário não pode ser alterado</small>
                        </div>

                        <div class="form-group">
                            <label>E-mail</label>
                            <input type="email" id="profileEmail" disabled />
                            <small>Para alterar o e-mail, entre em contato com o suporte</small>
                        </div>

                        <div class="form-group">
                            <label>Membro desde</label>
                            <input type="text" id="profileCreatedAt" disabled />
                        </div>
                    </div>

                    <div class="card glass-panel">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="shield-check"></i> Permissões</h3>
                        </div>
                        <div id="policiesList" style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                            <!-- Policies badges -->
                        </div>
                    </div>
                </section>

                <!-- Security Section -->
                <section id="security" class="content-section">
                    <h2 class="section-title"><i data-lucide="shield"></i> Segurança da Conta</h2>

                    <div class="card glass-panel">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="lock"></i> Alterar Senha</h3>
                        </div>

                        <div id="passwordAlert" class="alert"></div>

                        <div class="form-group">
                            <label>Senha Atual</label>
                            <input type="password" id="currentPassword" placeholder="Digite sua senha atual" />
                        </div>

                        <div class="form-group">
                            <label>Nova Senha</label>
                            <input type="password" id="newPassword" placeholder="Digite a nova senha" />
                            <small>Mínimo 8 caracteres, incluindo maiúsculas, números e símbolos</small>
                        </div>

                        <div class="form-group">
                            <label>Confirmar Nova Senha</label>
                            <input type="password" id="confirmPassword" placeholder="Confirme a nova senha" />
                        </div>

                        <div class="btn-group">
                            <button class="btn btn-primary" id="btnChangePassword">
                                <i data-lucide="save"></i> Alterar Senha
                            </button>
                        </div>
                    </div>

                    <div class="card glass-panel">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="mail-check"></i> Verificação de E-mail</h3>
                        </div>
                        <div id="emailVerificationStatus">
                            <p style="color: var(--text-muted);">Verificando status...</p>
                        </div>
                    </div>
                </section>

                <!-- API Keys Section -->
                <section id="api-keys" class="content-section">
                    <h2 class="section-title"><i data-lucide="key"></i> Chaves de API</h2>

                    <div class="card glass-panel">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="sparkles"></i> Inteligência Artificial</h3>
                        </div>

                        <div id="apiKeysAlert" class="alert"></div>

                        <div class="api-key-item">
                            <div class="api-key-info">
                                <div class="api-key-icon">
                                    <i data-lucide="bot" style="color: var(--primary);"></i>
                                </div>
                                <div>
                                    <div class="api-key-name">Google Gemini API</div>
                                    <div class="api-key-status" id="geminiStatus">Não configurada</div>
                                </div>
                            </div>
                            <button class="btn btn-secondary btn-sm" onclick="toggleGeminiKeyInput()">
                                <i data-lucide="edit-2"></i>
                            </button>
                        </div>

                        <div id="geminiKeyForm" style="display: none; margin-top: 1rem;">
                            <div class="form-group">
                                <label>Chave da API Gemini</label>
                                <div class="input-group">
                                    <input type="password" id="geminiApiKey" placeholder="AIzaSy..." />
                                    <button class="btn btn-secondary" onclick="togglePasswordVisibility('geminiApiKey')">
                                        <i data-lucide="eye"></i>
                                    </button>
                                </div>
                                <small>Obtenha sua chave em <a href="https://aistudio.google.com/apikey" target="_blank" style="color: var(--primary);">Google AI Studio</a></small>
                            </div>
                            <div class="btn-group">
                                <button class="btn btn-primary" id="btnSaveGeminiKey">
                                    <i data-lucide="save"></i> Salvar Chave
                                </button>
                                <button class="btn btn-danger" onclick="clearGeminiKey()">
                                    <i data-lucide="trash-2"></i> Remover
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card glass-panel">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="info"></i> Sobre as Chaves de API</h3>
                        </div>
                        <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;">
                            As chaves de API são armazenadas de forma segura e criptografada no servidor. 
                            Elas são usadas para acessar recursos de inteligência artificial como geração de imagens e otimização de layout.
                            <br><br>
                            <strong>Nota:</strong> Nunca compartilhe suas chaves de API com terceiros.
                        </p>
                    </div>
                </section>

                <!-- Preferences Section -->
                <section id="preferences" class="content-section">
                    <h2 class="section-title"><i data-lucide="settings"></i> Preferências</h2>

                    <div class="card glass-panel">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="palette"></i> Interface</h3>
                        </div>

                        <div class="toggle-group">
                            <div class="toggle-info">
                                <h4>Tema Escuro</h4>
                                <p>Usar tema escuro em toda a aplicação</p>
                            </div>
                            <label class="toggle">
                                <input type="checkbox" id="prefDarkTheme" checked>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>

                        <div class="toggle-group">
                            <div class="toggle-info">
                                <h4>Grade do Canvas</h4>
                                <p>Mostrar grade de pixels no editor</p>
                            </div>
                            <label class="toggle">
                                <input type="checkbox" id="prefShowGrid" checked>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>

                        <div class="toggle-group">
                            <div class="toggle-info">
                                <h4>Auto-salvar</h4>
                                <p>Salvar automaticamente alterações no projeto</p>
                            </div>
                            <label class="toggle">
                                <input type="checkbox" id="prefAutoSave" checked>
                                <span class="toggle-slider"></span>
                            </label>
                        </div>

                        <div class="toggle-group">
                            <div class="toggle-info">
                                <h4>Notificações</h4>
                                <p>Receber notificações sobre atualizações</p>
                            </div>
                            <label class="toggle">
                                <input type="checkbox" id="prefNotifications">
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="card glass-panel">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="globe"></i> Regional</h3>
                        </div>

                        <div class="form-group">
                            <label>Idioma</label>
                            <select id="prefLanguage">
                                <option value="pt-BR" selected>Português (Brasil)</option>
                                <option value="en-US">English (US)</option>
                                <option value="es">Español</option>
                            </select>
                        </div>
                    </div>

                    <div class="btn-group">
                        <button class="btn btn-primary" id="btnSavePreferences">
                            <i data-lucide="save"></i> Salvar Preferências
                        </button>
                    </div>
                </section>

                <!-- Sessions Section -->
                <section id="sessions" class="content-section">
                    <h2 class="section-title"><i data-lucide="monitor"></i> Sessões Ativas</h2>

                    <div class="card glass-panel">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="laptop"></i> Dispositivos Conectados</h3>
                            <button class="btn btn-danger btn-sm" id="btnLogoutAll">
                                <i data-lucide="log-out"></i> Encerrar Todas
                            </button>
                        </div>

                        <div class="session-item session-current">
                            <div class="session-info">
                                <i data-lucide="monitor" style="color: var(--success);"></i>
                                <div>
                                    <strong>Este dispositivo</strong>
                                    <p style="font-size: 0.8rem; color: var(--text-muted);">
                                        Sessão atual • <span id="currentBrowser">-</span>
                                    </p>
                                </div>
                            </div>
                            <span style="color: var(--success); font-size: 0.8rem;">Ativa agora</span>
                        </div>
                    </div>

                    <div class="card glass-panel">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="history"></i> Histórico de Acesso</h3>
                        </div>
                        <p style="color: var(--text-muted); font-size: 0.9rem;">
                            O histórico de acessos está disponível nos logs de auditoria do sistema.
                        </p>
                    </div>
                </section>

                <!-- Danger Zone Section -->
                <section id="danger" class="content-section">
                    <h2 class="section-title" style="color: var(--error);"><i data-lucide="alert-triangle"></i> Zona de Perigo</h2>

                    <div class="card glass-panel danger-zone">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="trash-2"></i> Excluir Conta</h3>
                        </div>
                        <p style="color: var(--text-muted); margin-bottom: 1rem;">
                            Esta ação é <strong>irreversível</strong>. Todos os seus dados, projetos e configurações serão permanentemente excluídos.
                        </p>
                        <button class="btn btn-danger" id="btnDeleteAccount">
                            <i data-lucide="trash-2"></i> Excluir Minha Conta
                        </button>
                    </div>

                    <div class="card glass-panel danger-zone">
                        <div class="card-header">
                            <h3 class="card-title"><i data-lucide="download"></i> Exportar Dados</h3>
                        </div>
                        <p style="color: var(--text-muted); margin-bottom: 1rem;">
                            Baixe uma cópia de todos os seus dados pessoais armazenados no sistema.
                        </p>
                        <button class="btn btn-secondary" id="btnExportData">
                            <i data-lucide="download"></i> Exportar Meus Dados
                        </button>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <script src="~/js/account-profile.js"></script>
</body>
</html>

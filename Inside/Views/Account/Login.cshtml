@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login | PixelDisplay240</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            /* DevOps Palette */
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --primary: #38bdf8;
            --primary-hover: #0ea5e9;
            --secondary: #334155;
            --accent: #818cf8;
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            --border: #334155;

            /* Status Colors */
            --success: #4ade80;
            --error: #ef4444;
            --warning: #f59e0b;

            /* Branding Gradient */
            --brand-gradient: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);

            --font-family: 'Outfit', sans-serif;
            --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-family);
            background: radial-gradient(circle at top right, #1e293b, #0f172a);
            color: var(--text-main);
            min-height: 100vh;
            overflow: hidden;
        }

        /* Glassmorphism utility */
        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--card-shadow);
        }

        .login-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 1.5rem;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            padding: 3rem;
            position: relative;
            overflow: hidden;
            animation: fadeIn 0.8s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-logo {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            font-weight: 700;
            letter-spacing: -1px;
            background: var(--brand-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-align: center;
        }

        .login-subtitle {
            color: var(--text-muted);
            text-align: center;
            margin-bottom: 2.5rem;
            font-size: 0.95rem;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-main);
            margin-left: 2px;
        }

        input[type="text"],
        input[type="password"],
        input[type="email"] {
            width: 100%;
            padding: 0.75rem 1rem;
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-main);
            font-size: 1rem;
            font-family: var(--font-family);
            transition: all 0.3s ease;
        }

        input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
        }

        input::placeholder {
            color: var(--text-muted);
        }

        .remember-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
        }

        .remember-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.875rem;
            color: var(--text-muted);
            cursor: pointer;
        }

        .remember-label input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--primary);
        }

        button {
            width: 100%;
            padding: 0.75rem 1.5rem;
            background: var(--primary);
            color: var(--bg-dark);
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            font-family: var(--font-family);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        button:hover {
            background: var(--primary-hover);
            transform: translateY(-1px);
        }

        button:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

        .login-footer {
            margin-top: 2rem;
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .login-footer a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }

        .login-footer a:hover {
            text-decoration: underline;
        }

        #out {
            margin-top: 1.5rem;
            padding: 1rem;
            border-radius: 8px;
            font-size: 0.85rem;
            display: none;
            animation: slideUp 0.3s ease-out;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .error-msg {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid var(--error);
            color: #fca5a5;
        }

        .success-msg {
            background: rgba(74, 222, 128, 0.1);
            border: 1px solid var(--success);
            color: #86efac;
        }

        .info-msg {
            background: rgba(56, 189, 248, 0.1);
            border: 1px solid var(--primary);
            color: #bae6fd;
        }

        /* Animated background elements */
        .blob {
            position: absolute;
            width: 300px;
            height: 300px;
            background: var(--primary);
            filter: blur(80px);
            opacity: 0.15;
            z-index: -1;
            border-radius: 50%;
        }

        .blob-1 {
            top: -100px;
            right: -100px;
        }

        .blob-2 {
            bottom: -100px;
            left: -100px;
            background: var(--accent);
        }

        .spinner {
            width: 18px;
            height: 18px;
            border: 2px solid transparent;
            border-top-color: var(--bg-dark);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        .copyright {
            text-align: center;
            margin-top: 2rem;
            font-size: 0.75rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>

    <div class="login-container">
        <div class="login-card glass-panel">
            <div class="login-logo">PixelDisplay240</div>
            <div class="login-subtitle">Acesso seguro ao painel Inside Edition</div>

            <div class="form-group">
                <label for="username">Usuário</label>
                <input id="username" type="text" placeholder="Digite seu usuário" autocomplete="username">
            </div>

            <div class="form-group">
                <label for="password">Senha</label>
                <input id="password" type="password" placeholder="Digite sua senha" autocomplete="current-password">
            </div>

            <div class="remember-row">
                <label class="remember-label">
                    <input type="checkbox" id="remember">
                    Lembrar de mim
                </label>
                <a href="/Account/ForgotPassword" style="font-size: 0.875rem; color: var(--primary); text-decoration: none; font-weight: 600;">Esqueceu sua senha?</a>
            </div>

            <button id="btnLogin">Entrar no Sistema</button>

            <div class="login-footer">
                <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.05);">
                    Não tem uma conta? <a href="/Account/Register">Cadastre-se</a>
                </div>
            </div>

            <div id="out"></div>

            <p class="copyright">
                &copy; 2025 PixelDisplay240. Todos os direitos reservados.
            </p>
        </div>
    </div>

    <script>
        // API URL - PixelDisplay240 interno
        const AUTH_API_URL = '/api/auth';

        function showMessage(type, message) {
            const out = document.getElementById('out');
            out.className = type + '-msg';
            out.textContent = message;
            out.style.display = 'block';
        }

        function hideMessage() {
            const out = document.getElementById('out');
            out.style.display = 'none';
        }

        document.getElementById('btnLogin').addEventListener('click', async () => {
            const btn = document.getElementById('btnLogin');
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value;
            const remember = document.getElementById('remember').checked;

            hideMessage();

            // Validacao basica
            if (!username || !password) {
                showMessage('error', 'Por favor, preencha todos os campos.');
                return;
            }

            // Loading state
            btn.disabled = true;
            btn.innerHTML = '<div class="spinner"></div><span>Entrando...</span>';

            try {
                // Login com usuario e senha
                const response = await fetch(`${AUTH_API_URL}/login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || 'Credenciais inválidas');
                }

                // Store tokens
                const storage = remember ? localStorage : sessionStorage;
                storage.setItem('pd240_token', data.token);
                storage.setItem('pd240_refresh_token', data.refreshToken);
                storage.setItem('pd240_expires', data.expiresAt);
                storage.setItem('pd240_user', JSON.stringify({
                    username: data.username,
                    email: data.email,
                    role: data.role,
                    policies: data.policies
                }));

                // Success feedback
                showMessage('success', 'Login realizado com sucesso!');

                // Redirect to returnUrl or home
                const urlParams = new URLSearchParams(window.location.search);
                const returnUrl = urlParams.get('returnUrl') || '/';
                
                setTimeout(() => {
                    window.location.href = returnUrl;
                }, 500);

            } catch (error) {
                showMessage('error', error.message || 'Erro ao fazer login');
                btn.disabled = false;
                btn.textContent = 'Entrar no Sistema';
            }
        });

        // Allow Enter key to submit
        document.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                document.getElementById('btnLogin').click();
            }
        });

        // Check if already logged in
        const token = localStorage.getItem('pd240_token') || sessionStorage.getItem('pd240_token');
        const expires = localStorage.getItem('pd240_expires') || sessionStorage.getItem('pd240_expires');

        if (token && expires) {
            const expiresDate = new Date(expires);
            if (expiresDate > new Date()) {
                // Token valido, redirecionar para returnUrl ou home
                const urlParams = new URLSearchParams(window.location.search);
                const returnUrl = urlParams.get('returnUrl') || '/';
                window.location.href = returnUrl;
            } else {
                // Token expirado, limpar storage
                localStorage.removeItem('pd240_token');
                localStorage.removeItem('pd240_expires');
                localStorage.removeItem('pd240_refresh_token');
                localStorage.removeItem('pd240_user');
                sessionStorage.removeItem('pd240_token');
                sessionStorage.removeItem('pd240_expires');
                sessionStorage.removeItem('pd240_refresh_token');
                sessionStorage.removeItem('pd240_user');
            }
        }
    </script>
</body>
</html>

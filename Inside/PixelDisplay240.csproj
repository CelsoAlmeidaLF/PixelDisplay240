<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="wwwroot\css\style.css" />
    <Content Remove="wwwroot\js\controller.js" />
    <Content Remove="wwwroot\js\designer.js" />
    <Content Remove="wwwroot\js\script.js" />
    <Content Remove="wwwroot\js\view.js" />
  </ItemGroup>
  <ItemGroup>
    <None Include="wwwroot\css\style.css" />
    <None Include="wwwroot\js\controller.js" />
    <None Include="wwwroot\js\designer.js" />
    <None Include="wwwroot\js\script.js" />
    <None Include="wwwroot\js\view.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.405" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
  </ItemGroup>
</Project>
